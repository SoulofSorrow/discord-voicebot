{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npx eslint:*)",
      "Bash(node --test:*)",
      "Bash(make help)",
      "Bash(make info)",
      "Bash(make check-git)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm run deploy)",
      "Bash(node deploy-commands.js)",
      "Bash(npm run lint:fix)",
      "Bash(npm run deps:update)",
      "Bash(make clean)",
      "Bash(make set-git-local)",
      "Bash(make install-hooks)",
      "Bash(make setup)",
      "Bash(docker compose up:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./data/**)"
    ]
  }
}
